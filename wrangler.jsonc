{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ingesoft2-plataforma",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "routes": [
    { "pattern": "ingesoftun4l.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}